# Configuration MonEstimation Backend FastAPI
# Production: copier vers .env et configurer les valeurs

# API
ESTIMATION_DEBUG=false

# Warehouse Horizon (PostgreSQL + PostGIS)
# En prod Docker: utiliser le nom du container horizon
ESTIMATION_WAREHOUSE_HOST=horizon-warehouse-db
ESTIMATION_WAREHOUSE_PORT=5432
ESTIMATION_WAREHOUSE_DB=horizon_warehouse
ESTIMATION_WAREHOUSE_USER=horizon
ESTIMATION_WAREHOUSE_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE

# Redis
ESTIMATION_REDIS_URL=redis://estimation_redis:6379/1

# CORS (séparés par virgule)
ESTIMATION_CORS_ORIGINS=https://vendremonimmeuble.fr,https://www.vendremonimmeuble.fr,https://estimermonimmeuble.fr,https://www.estimermonimmeuble.fr,https://estimermonimmeuble.com,https://www.estimermonimmeuble.com
