# Configuration MonEstimation Backend FastAPI

# API
ESTIMATION_DEBUG=false

# Warehouse Horizon (PostgreSQL + PostGIS)
ESTIMATION_WAREHOUSE_HOST=localhost
ESTIMATION_WAREHOUSE_PORT=5432
ESTIMATION_WAREHOUSE_DB=horizon_warehouse
ESTIMATION_WAREHOUSE_USER=postgres
ESTIMATION_WAREHOUSE_PASSWORD=postgres

# Redis
ESTIMATION_REDIS_URL=redis://localhost:6379/0

# CORS (séparés par virgule)
ESTIMATION_CORS_ORIGINS=http://localhost:3000,https://vendremonimmeuble.fr,https://estimermonimmeuble.fr

# Géocodage IGN (optionnel)
ESTIMATION_IGN_API_KEY=
